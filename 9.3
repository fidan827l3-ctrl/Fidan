class User:

    def __init__(self, first_name, last_name, username, email, location):
        self.first_name = first_name
        self.last_name = last_name
        self.username = username
        self.email = email
        self.location = location

    def describe_user(self):
        print("\n--- İstifadəçi məlumatları ---")
        print(f"Ad və soyad: {self.first_name} {self.last_name}")
        print(f"İstifadəçi adı: @{self.username}")
        print(f"E-poçt: {self.email}")
        print(f"Şəhər/Ünvan: {self.location}")

    def.greet_user (self):
        print(f"Xoş gəlmisiniz, {self.first_name} {self.last_name}!")


user1 = User("Aysel", "Məmmədova", "aysel_m", "aysel@example.com", "Bakı")
user2 = User("Murad", "Əliyev", "murad_a", "murad@example.com", "Gəncə")
user3 = User("Nigar", "Hüseynova", "nigar_h", "nigar@example.com", "Şuşa")

for user in (user1, user2, user3):
    user.describe_user()
    user.greet_user()
